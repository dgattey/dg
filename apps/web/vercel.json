{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/books/goodreads-sync",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "src/app/api/books/goodreads-sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/books/sync/route.ts": {
      "maxDuration": 60
    }
  },
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ] && [ \"$VERCEL_GIT_COMMIT_REF\" != main ] && ! git log -n 10 --format=%s | grep -q '^Bump version to v'"
}
