#!/usr/bin/env bash
# Installs the Node version from .node-version into /usr/local and activates
# the pinned pnpm. The Cloud Agent snapshot ships an older Node, and install
# runs in a non-interactive login shell, so version managers don't load.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NODE_VERSION="$(cat "${ROOT_DIR}/.node-version")"

if [ "$(/usr/local/bin/node -v 2>/dev/null)" != "v${NODE_VERSION}" ]; then
  case "$(uname -m)" in
    x86_64) ARCH=x64 ;;
    aarch64 | arm64) ARCH=arm64 ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" \
    | sudo tar -xJ -C /usr/local --strip-components=1 --no-same-owner
fi

sudo /usr/local/bin/corepack enable --install-directory /usr/local/bin pnpm
PNPM_VERSION="$(/usr/local/bin/node -p "require('${ROOT_DIR}/package.json').packageManager.match(/pnpm@([^+]+)/)[1]")"
COREPACK_ENABLE_DOWNLOAD_PROMPT=0 /usr/local/bin/corepack prepare "pnpm@${PNPM_VERSION}" --activate

if [ "$(node -v)" != "v${NODE_VERSION}" ]; then
  echo "PATH resolves node to $(command -v node) ($(node -v)), not /usr/local/bin v${NODE_VERSION}" >&2
  exit 1
fi
echo "Using Node $(node -v) and pnpm $(pnpm -v)"
