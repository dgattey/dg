#!/usr/bin/env bash
# Links the dyl-stack, pstack and cursor-team-kit skills and subagents from
# cursor/plugins into ~/.cursor so Cloud Agents can use them. Cloud Agents
# don't reliably get marketplace plugin skills, so the environment install
# runs this instead.
set -euo pipefail

PLUGINS=(dyl-stack pstack cursor-team-kit)
SRC="${HOME}/.cursor/plugin-sources/cursor-plugins"

if [ -d "${SRC}/.git" ]; then
  git -C "$SRC" fetch -q --depth 1 origin main
  git -C "$SRC" reset -q --hard FETCH_HEAD
else
  rm -rf "$SRC"
  git clone -q --depth 1 --filter=blob:none --sparse https://github.com/cursor/plugins "$SRC"
fi
git -C "$SRC" sparse-checkout set "${PLUGINS[@]}"

mkdir -p "${HOME}/.cursor/skills" "${HOME}/.cursor/agents"
for plugin in "${PLUGINS[@]}"; do
  for skill in "${SRC}/${plugin}"/skills/*/; do
    ln -sfn "${skill%/}" "${HOME}/.cursor/skills/$(basename "$skill")"
  done
  for agent in "${SRC}/${plugin}"/agents/*.md; do
    ln -sfn "$agent" "${HOME}/.cursor/agents/$(basename "$agent")"
  done
done

echo "Linked Cloud Agent plugins from cursor/plugins@$(git -C "$SRC" rev-parse --short HEAD)"
