{
  "dependencies": {
    "chalk": "6.0.1",
    "ora": "9.4.1"
  },
  "devDependencies": {
    "@dg/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "name": "@dg/cli",
  "private": true,
  "scripts": {
    "check": "biome check --write . && tsx src/check-structure.ts",
    "check:ci": "biome ci . && tsx src/check-structure.ts",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "drop-bot-commits": "tsx src/git-drop-bot-commits.ts",
    "env": "tsx src/env.ts",
    "generate:grain": "tsx src/generate-grain.ts",
    "setup": "tsx src/setup.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "tunnel": "tsx src/tunnel.ts",
    "version:bump": "tsx src/version.ts bump",
    "version:pr-comment": "tsx src/version.ts pr-comment",
    "version:release-info": "tsx src/version.ts release-info"
  },
  "type": "module",
  "version": "1.0.0"
}
